+
+    def dispose(self):
+        for window in tuple(self.windows.values()):
+            window._dispose()
+        self.windows.clear()
+        self.runs.clear()
+        self.threads.clear()
+        self.dispatcher.dispose()
+        self.channel.requests.clear()
+        self.app = None
