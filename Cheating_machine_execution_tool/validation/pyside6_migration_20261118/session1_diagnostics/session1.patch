+"""Read the original evidence cache only for a verified local project run and target."""
+from configparser import Error as ConfigError
+import json
+
+from src.models.project_task import task_path
+from src.services.ai_evidence_context import AiEvidenceContext
+from src.services.qt_ai_report_handoff import QtAiReportHandoff
+
+
+class QtPowerEvidence(AiEvidenceContext):
+    def __init__(self, project):
+        super().__init__()
+        self.project = project
+        self.config = None
+        self.start_targets = ()
+
+    def _snapshot_targets(self, directory):
+        root = directory.parent.parent
+        metadata = root / 'run.json'
+        if (root.parent != self.project.root / 'runs' or directory != root / 'Auto_power_on_off_tool/config'
+                or directory.resolve() != directory or metadata.resolve() != metadata):
+            raise ValueError('运行配置来源无法核对')
+        record = json.loads(metadata.read_text('utf-8-sig'))
+        if (not isinstance(record, dict) or record.get('project_id') != self.project.identity.project_id
+                or record.get('run_id') != root.name):
+            raise ValueError('运行配置身份无法核对')
+        return QtAiReportHandoff.targets_from_config(directory)
+
+    def observe(self, message):
+        directory = task_path(self.project.config_dir)
+        starting = message.get('type') == 'diagnostic_start'
+        if starting:
+            try:
+                targets = self._snapshot_targets(directory)
+            except (OSError, ConfigError, ValueError, RuntimeError):
+                targets = ()
+        with self.lock:
+            if starting:
+                run = str(message['run_id'])
+                if self.run_id != run:
+                    self.config = directory if targets else None
+                    self.start_targets = targets
+                elif directory != self.config or targets != self.start_targets:
+                    # Conflicting starts cannot rebind records already collected for this ID.
+                    self.config = None
+            elif self.config is not None and (directory != self.config or message.get('run_id') != self.run_id):
+                return
+            super().observe(message)
+
+    def for_channel(self, run, target, saved_snapshot):
+        with self.lock:
+            directory = self.config
+            if run != self.run_id or directory is None:
+                raise ValueError('缺少可核对的本批次配置，保留已有材料')
+            snapshot_id = directory.parent.parent.name
+            if saved_snapshot and saved_snapshot != snapshot_id:
+                raise ValueError('会话所属的运行快照已变化，保留已有材料')
+            if target not in self.start_targets:
+                raise ValueError('通道目标与批次开始时不一致，保留已有材料')
+        try:
+            frozen = self._snapshot_targets(directory)
+            current = QtAiReportHandoff.targets_from_config(self.project.config_dir, target.channel)
+        except (OSError, ConfigError, ValueError, RuntimeError) as error:
+            raise ValueError('运行快照或项目配置无法读取或核对，保留已有材料') from error
+        if target not in frozen or current != (target,):
+            raise ValueError('通道目标与运行快照或当前配置不一致，保留已有材料')
+        items = self.snapshot(run, target.channel)
+        with self.lock:
+            if run != self.run_id or directory != self.config:
+                raise ValueError('取证期间批次已变化，保留已有材料')
+            return items, self.target_settings(run, target.channel), snapshot_id
