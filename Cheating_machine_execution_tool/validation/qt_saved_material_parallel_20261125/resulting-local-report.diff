+    def test_material_batch_cancel_preserves_completed_channel_and_marks_rest_without_read(self):
+        target, record, _ = self.material_batch_fixture()
+        stop = Event()
+        first_done = Event()
+        calls = []
+
+        def read(context, saved, row, cancel):
